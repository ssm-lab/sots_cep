        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;Signal change commands are issued at incorrect intervals, resulting in visibly mis-timed traffic light transitions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="4030" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;Emergency vehicles still receive guidance, but increased missed signal changes and latency reduce routing efficiency.&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="4140" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;Inconsistencies propagate beyond recovery thresholds halting emergency routing support entirely.&lt;/font&gt;" vertex="1">
