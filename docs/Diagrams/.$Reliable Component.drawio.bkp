        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;Traffic signal DTs&amp;nbsp; stream synchronized telemetry data, and the CEP engine coordinates traffic signal changes&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3584.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;A configuration defect is introduced in a constituents time-synchronization module&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3694.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;The defect activates during heavy traffic, causing occasional timestamp inconsistencies&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3804.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;fontFamily=Times New Roman;" value="&lt;font&gt;The CEP engine incorporates inconsistent timestamps into its correlation windows&lt;/font&gt;" vertex="1">
