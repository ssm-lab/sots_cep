        <mxCell id="xCmVV6YmWgiIf5GXmQ6Y-8" connectable="0" parent="xCmVV6YmWgiIf5GXmQ6Y-7" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=13;" value="[&lt;font face=&quot;Times New Roman&quot; style=&quot;color: rgb(166, 128, 184);&quot;&gt;Degraded&lt;/font&gt;]&lt;div&gt;&lt;b style=&quot;color: rgb(51, 153, 255); font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;announce_departure&lt;/b&gt;&lt;/div&gt;" vertex="1">
