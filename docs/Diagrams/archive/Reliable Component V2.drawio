        <mxCell id="99Fv-t0iNpyfbdN2IQlz-246" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Level 1&lt;/h1&gt;&lt;p&gt;adds formal announcments to joining and leaving the constellations&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="-3160" y="5400" as="geometry" />
        </mxCell>
        <mxCell id="99Fv-t0iNpyfbdN2IQlz-247" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Level 2&lt;/h1&gt;&lt;p&gt;Adds the particippating and pending state into active&lt;/p&gt;&lt;p&gt;Here depature notice is given and the SoS can extend a constituents time in a constellation or they can leave after the elapsed notice&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="190" x="-2305" y="5510" as="geometry" />
        </mxCell>
        <mxCell id="99Fv-t0iNpyfbdN2IQlz-248" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Level 3&lt;/h1&gt;&lt;div&gt;We expand the passive state to include memeber and negotiating&lt;/div&gt;&lt;div&gt;consituents have to be let into constelations first before joining and can be kicked out by the SoS&lt;/div&gt;&lt;div&gt;While participting consititnets canm be denied from leaving if they still have obligations (contractual, task, ect)&lt;/div&gt;&lt;div&gt;Once the departure conditions have been met (ex like a contract expiring, then they can leave into passive)&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="210" x="-1900" y="5590" as="geometry" />
        </mxCell>
        <mxCell id="99Fv-t0iNpyfbdN2IQlz-249" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=13;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Level 4&lt;/h1&gt;&lt;div&gt;Here the participating state is expanding to include ideas about role changes enforced by the SoS&lt;/div&gt;&lt;div&gt;if a constituent leaves, the SoS can request to change roles in other constituents to make up for the missed capability&lt;/div&gt;&lt;div&gt;Consittuents can still request to depart if they don&#39;t agree or request a differemnt role change to something they prefer&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="600" x="-80" y="5460" as="geometry" />
        </mxCell>
        <mxCell id="99Fv-t0iNpyfbdN2IQlz-288" edge="1" parent="1" source="99Fv-t0iNpyfbdN2IQlz-254" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=13;" target="99Fv-t0iNpyfbdN2IQlz-284">
