        <mxCell id="99Fv-t0iNpyfbdN2IQlz-227" connectable="0" parent="99Fv-t0iNpyfbdN2IQlz-226" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=13;" value="leave SoS" vertex="1">
