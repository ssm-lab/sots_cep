        <mxCell id="sSbzp_ixrgXS73PfgRmn-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;SoTS Scenario - Emergency Response Vehicle Routing&lt;/font&gt;" vertex="1">
          <mxGeometry height="96.5" width="200" x="-1465" y="3481.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;Traffic signal DTs&amp;nbsp; stream synchronized telemetry data, and the CEP engine coordinates traffic signal changes&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3584.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;A configuration defect is introduced in a constituents time-synchronization module&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3694.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;The defect activates during heavy traffic, causing occasional timestamp inconsistencies&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3804.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;The CEP engine incorporates inconsistent timestamps into its correlation windows&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="3920" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;Signal change commands are issued at incorrect intervals, resulting in visibly mis-timed traffic light transitions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="4030" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;Emergency vehicles still receive guidance, but increased missed signal changes and latency reduce routing efficiency.&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="4140" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;font&gt;Inconsistencies propagate beyond recovery thresholds halting emergency routing support entirely.&lt;/font&gt;" vertex="1">
          <mxGeometry height="73.5" width="240" x="-1485" y="4244.75" as="geometry" />
        </mxCell>
        <mxCell id="sSbzp_ixrgXS73PfgRmn-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=13;" value="&lt;div style=&quot;line-height: 100%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;line-height: 100%;&quot;&gt;&lt;b&gt;Collapse Defective and Faulty&lt;/b&gt; because both represent internal component-level impairment without observable system impact.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 100%;&quot;&gt;&lt;b&gt;Collapse Malfunctioning and Degraded&lt;/b&gt; because both reflect observable but recoverable service impact.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;line-height: 100%;&quot;&gt;&lt;b&gt;Maybe - Collapse Erroneous and Malfunctioning &lt;/b&gt;because corrupted state and incorrect behavior can&#39;t really be meaningfully separated.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
