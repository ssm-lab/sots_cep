  <sgraph:Statechart xmi:id="_WnyrMBscEfGRqN3GfjfnAg" specification="// Use the event driven execution model.&#xA;// Switch to cycle based behavior&#xA;// by specifying '@CycleBased(200)'.&#xA;@EventDriven&#xA;&#xA;// Use @SuperSteps(yes) to enable&#xA;// super step semantics.&#xA;@SuperSteps(no)&#xD;&#xA;&#xA;&#xA;// parameters to send to function&#xA;internal:&#xA;&#x9;const delta: integer = 5&#xA;&#x9;const JS: string = &quot;join_SoS&quot;&#xA;&#x9;const LS: string = &quot;leave_SoS&quot;&#xA;&#x9;const JC: string = &quot;join_constellation&quot;&#xA;&#x9;const LC: string = &quot;leave_constellation&quot;&#xA;&#x9;const LI: string = &quot;leave_initated&quot;&#xA;&#x9;&#xA;&#x9;const disengaged_id: integer = 1&#xA;&#x9;const prepared_id: integer = 2&#xA;&#x9;const passive_id: integer = 3&#xA;&#x9;const active_id: integer = 4&#xA;&#x9;const active_entry_id: integer = 5&#xA;&#x9;const active_participating_id: integer = 6&#xA;&#x9;const active_exit_id: integer = 7&#xA;&#x9;&#xA;&#x9;const ideal_id: integer = 1&#xA;&#x9;const defective_id: integer = 2&#xA;&#x9;const faulty_id: integer = 3&#xA;&#x9;const erroneous_id: integer = 4&#xA;&#x9;const malfunc_id: integer = 5&#xA;&#x9;const degraded_id: integer = 6&#xA;&#x9;const failed_id: integer = 7&#xA;&#x9;&#xA;&#x9;event health_changed&#xA;&#x9;&#xA;interface:&#xA;&#x9;// Define events and variables here. &#xA;&#x9;// Use CTRL + Space for content assist.&#xA;&#x9;// For debugging &#xA;&#x9;var belong_id : integer = 0&#xA;&#x9;var health_id : integer = 0&#xA;&#x9;&#xA;&#x9;// constituent states&#xA;&#x9;in event prepare_for_SoS&#xA;&#x9;in event disengage_from_SoS&#xA;&#x9;in event join_SoS&#xA;&#x9;in event leave_SoS&#xA;&#x9;in event join_constellation&#xA;&#x9;in event leave_constellation&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;in event leave_request&#xA;&#x9;in event exit_denied&#xA;&#x9; &#xA;&#x9;in event join_request&#xA;&#x9;in event join_invitation&#xA;&#x9;in event admission_rejected&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;//health states &#xA;&#x9;in event recovery&#xA;&#x9;in event component_deviation&#xA;&#x9;in event defect_activated&#xA;&#x9;in event fault_exercised&#xA;&#x9;in event error_propogation&#xA;&#x9;in event service_impact_observed&#xA;&#x9;in event service_threshold_violated&#xA;&#x9;&#xA;&#x9;out event announce : string" name="Statechart">
