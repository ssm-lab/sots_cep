  <sgraph:Statechart xmi:id="_WnyrMBscEfGRqN3GfjfnAg" specification="// Use the event driven execution model.&#xA;// Switch to cycle based behavior&#xA;// by specifying '@CycleBased(200)'.&#xA;@EventDriven&#xA;&#xA;// Use @SuperSteps(yes) to enable&#xA;// super step semantics.&#xA;@SuperSteps(no)&#xA;&#xA;&#xA;// parameters to send to function&#xA;internal:&#xA;&#x9;const JS: string = &quot;join_SoS&quot;&#xA;&#x9;const LS: string = &quot;leave_SoS&quot;&#xA;&#x9;const JC: string = &quot;join_constellation&quot;&#xA;&#x9;const LC: string = &quot;leave_constellation&quot;&#xA;&#x9;const LI: string = &quot;leave_initated&quot;&#x9;&#xA;&#x9;&#xA;&#x9;const DISENGAGED: string = &quot;disengaged&quot;&#xA;&#x9;const PREPARED: string = &quot;prepared&quot;&#xA;&#x9;&#xA;&#x9;//const PASSIVE: string = &quot;passive&quot;&#xA;&#x9;const AVAILABLE: string = &quot;available&quot;&#xA;&#x9;const NEGOTIATING: string = &quot;negotiating&quot;&#xA;&#x9;&#xA;&#x9;//const ACTIVE: string = &quot;active&quot;&#xA;&#x9;const PENDING_ENTRY: string = &quot;pending_entry&quot;&#xA;&#x9;//const PARTICIPATING: string = &quot;participating&quot;&#xA;&#x9;const FULL_ROLE: string = &quot;full_role&quot;&#xA;&#x9;const RESTRICTED_ROLE: string = &quot;restricted_role&quot;&#xA;&#x9;const PENDING_EXIT: string = &quot;pending_exit&quot;&#xA;&#x9;&#xA;&#x9;const IDEAL: string = &quot;ideal&quot;&#xA;&#x9;const DEFECTIVE: string = &quot;defective&quot;&#xA;&#x9;const FAULTY: string = &quot;faulty&quot;&#xA;&#x9;const ERRONEOUS: string = &quot;erroneous&quot;&#xA;&#x9;const MALFUNCTIONING: string = &quot;malfunctioning&quot;&#xA;&#x9;const DEGRADED: string = &quot;degraded&quot;&#xA;&#x9;const FAILED: string = &quot;failed&quot;&#xA;&#x9;&#xA;interface:&#xA;&#x9;// Define events and variables here. &#xA;&#x9;// Use CTRL + Space for content assist.&#xA;&#x9;&#xA;&#x9;// constituent states&#xA;&#x9;in event prepare_for_SoS&#xA;&#x9;in event disengage_from_SoS&#xA;&#x9;in event join_SoS&#xA;&#x9;in event leave_SoS&#xA;&#x9;in event join_constellation&#xA;&#x9;in event leave_constellation&#xA;&#x9;&#xA;&#x9;in event constellation_stable&#xA;&#x9;&#xA;&#x9;in event leave_request &#xA;&#x9;in event exit_denied&#xA;&#x9;&#xA;&#x9;in event join_request &#xA;&#x9;in event join_invitation&#xA;&#x9;in event admission_rejected&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;//health states &#xA;&#x9;in event full_recovery&#xA;&#x9;in event degrade&#xA;&#x9;in event improve&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;//in event defect_corrected&#xA;&#x9;//in event fault_removed&#xA;&#x9;//in event error_resolved&#xA;&#x9;//in event service_restored&#xA;&#x9;//in event performance_restored&#xA;&#xA;&#x9;//in event component_deviation&#xA;&#x9;//in event defect_activated&#xA;&#x9;//in event fault_exercised&#xA;&#x9;//in event error_propogation&#xA;&#x9;//in event service_impact_observed&#xA;&#x9;//in event service_threshold_violated&#xA;&#x9;&#xA;&#x9;//compensation triggers&#xA;&#x9;in event uncertainty_threshold_exceeded&#xA;&#x9;&#xA;&#x9;//connector events&#xA;&#x9;out event announce : string&#xA;&#x9;&#xA;&#x9;// permissions&#x9;&#xA;&#x9;out event emit_observed : boolean&#xA;&#x9;out event emit_validated : boolean&#xA;&#x9;out event compensation_enabled : boolean&#xA;&#x9;&#xA;&#x9;out event belonging_changed: string&#xA;&#x9;out event health_changed: string&#xA;&#x9;&#xA;&#x9;&#xA;&#x9;" name="Statechart">
